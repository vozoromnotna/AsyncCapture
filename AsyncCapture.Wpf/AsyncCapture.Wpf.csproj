<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <Authors>vozoromnotna</Authors>
        <Description>WPF extension of AsyncCapture library</Description>
        <PackageProjectUrl>https://github.com/vozoromnotna/AsyncCapture</PackageProjectUrl>
        <RepositoryUrl>https://github.com/vozoromnotna/AsyncCapture</RepositoryUrl>
        <Version>2.0.1</Version>
    </PropertyGroup>

    <ItemGroup>
      <Page Update="Hist\HistWindow.xaml">
        <Generator>MSBuild:Compile</Generator>
      </Page>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="DirectShowLib" Version="1.0.0" />
      <PackageReference Include="Extended.Wpf.Toolkit" Version="5.0.0" />
      <PackageReference Include="ScottPlot.WPF" Version="4.1.74" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AsyncCapture.Core\AsyncCapture.Core.csproj" />
    </ItemGroup>

</Project>
