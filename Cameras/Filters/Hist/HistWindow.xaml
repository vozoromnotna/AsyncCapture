<Window x:Class="AsyncCapture.Cameras.Filters.Hist.HistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:ScottPlot="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="HistWindow" Height="450" Width="800"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="153*"/>
            <ColumnDefinition Width="647*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <CheckBox IsChecked="{Binding AutoProperty.Value}" Content="Auto" Margin="10"/>
            <Label>Верхний порог</Label>
            <xctk:DoubleUpDown Increment="0.01" Value="{Binding ThresholdHighProperty.Value}" Minimum="{Binding ThresholdHighProperty.MinValue}" Maximum="{Binding ThresholdHighProperty.MaxValue}" FormatString="0.00" Margin="10 0 10 10"/>
            <ScrollBar Orientation="Horizontal" Value="{Binding ThresholdHighProperty.Value}" Minimum="{Binding ThresholdHighProperty.MinValue}" Maximum="{Binding ThresholdHighProperty.MaxValue}"  Margin="0 0 0 0"/>

            <Label>Нижний порог</Label>
            <xctk:DoubleUpDown Increment="0.01" Value="{Binding ThresholdLowProperty.Value}" Minimum="{Binding ThresholdLowProperty.MinValue}" Maximum="{Binding ThresholdLowProperty.MaxValue}" FormatString="0.00" Margin="10 0 10 10"/>
            <ScrollBar Orientation="Horizontal" Value="{Binding ThresholdLowProperty.Value}" Minimum="{Binding ThresholdLowProperty.MinValue}" Maximum="{Binding ThresholdLowProperty.MaxValue}"  Margin="0 0 0 0"/>

        </StackPanel>

        <ScottPlot:WpfPlot Grid.Column="1" x:Name="WP_Plot"/>
    </Grid>
</Window>
