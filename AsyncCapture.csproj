<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PackageId>AsyncCapture</PackageId>
    <Version>1.0.1</Version>
    <Authors>vozoromnotna</Authors>
    <Company>STC UI RAS</Company>
    <Description>A universal library for working with cameras </Description>
    <RepositoryUrl>https://github.com/vozoromnotna/AsyncCapture</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DirectShowLib" Version="1.0.0" />
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.6.1" />
    <PackageReference Include="gstreamer-sharp-netcore" Version="0.0.8" />
    <PackageReference Include="HDF5-CSharp" Version="1.19.0" />
    <PackageReference Include="ic4dotnet" Version="1.2.0.2954" />
    <PackageReference Include="ic4dotnet.OpenCvSharp" Version="1.2.0.2954" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Nito.AsyncEx.Context" Version="5.1.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <PackageReference Include="ScottPlot.WPF" Version="4.1.67" />
    <PackageReference Include="SerialDevicesLib" Version="1.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  
  
</Project>
